{
	"name": "@19h47/radiogroup",
	"version": "7.0.4",
	"description": "Custom radios elements with accessibility in mind",
	"type": "module",
	"files": [
		"dist"
	],
	"main": "./dist/radiogroup.umd.cjs",
	"module": "./dist/radiogroup.js",
	"types": "./dist/index.d.ts",
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"import": "./dist/radiogroup.js",
			"require": "./dist/radiogroup.umd.cjs"
		}
	},
	"scripts": {
		"release": "pnpm build && pnpm publish",
		"dev": "vite",
		"build": "vite build && tsc --emitDeclarationOnly"
	},
	"repository": {
		"type": "git",
		"url": "git://github.com/19h47/19h47-radiogroup.git"
	},
	"keywords": [
		"radio",
		"radios",
		"radiogroup",
		"ES6"
	],
	"author": "Jérémy Levron <jeremylevron@19h47.fr> (https://19h47.fr)",
	"license": "ISC",
	"bugs": {
		"url": "https://github.com/19h47/19h47-radiogroup/issues"
	},
	"homepage": "https://github.com/19h47/19h47-radiogroup#readme",
	"devDependencies": {
		"typescript": "^7.0.2",
		"vite": "^8.1.5"
	},
	"packageManager": "pnpm@10.26.1+sha512.664074abc367d2c9324fdc18037097ce0a8f126034160f709928e9e9f95d98714347044e5c3164d65bd5da6c59c6be362b107546292a8eecb7999196e5ce58fa"
}
